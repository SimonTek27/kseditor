#version 450

layout(push_constant) uniform SSAOPC {
    mat4 proj;
    mat4 invProj;
    vec4 samples[64];
    vec2 noiseScale;
    float radius;
    float bias;
    float power;
    float intensity;
    vec2 screenSize;
} pc;

layout(set = 1, binding = 0, rgba8) uniform readonly image2D gNormal;
layout(set = 1, binding = 1, r32f) uniform readonly image2D gDepth;
layout(set = 1, binding = 2, rg8) uniform readonly image2D noiseTex;
layout(set = 1, binding = 3, r8) uniform writeonly image2D outAO;

layout(local_size_x = 8, local_size_y = 8) in;

float linearDepth(float depth) {
    float z = depth * 2.0 - 1.0;
    return (2.0 * 0.1 * 1000.0) / (1000.0 + 0.1 - z * (1000.0 - 0.1));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 fragUV = vec2(coord) / pc.screenSize;

    vec3 normal = normalize(imageLoad(gNormal, coord).rgb * 2.0 - 1.0);
    float depth = imageLoad(gDepth, coord).r;
    vec4 clipPos = vec4(fragUV * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = pc.invProj * clipPos;
    viewPos /= viewPos.w;
    vec3 randomVec = normalize(vec3(imageLoad(noiseTex, ivec2(coord) % 4).xy, 0.0));
    vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);
    float occlusion = 0.0;
    for (int i = 0; i < 64; ++i) {
        vec3 samplePos = TBN * pc.samples[i].xyz;
        samplePos = viewPos.xyz + samplePos * pc.radius;
        vec4 offset = pc.proj * vec4(samplePos, 1.0);
        offset.xyz /= offset.w;
        offset.xyz = offset.xyz * 0.5 + 0.5;
        float sampleDepth = linearDepth(imageLoad(gDepth, ivec2(offset.xy * pc.screenSize)).r);
        float rangeCheck = smoothstep(0.0, 1.0, pc.radius / abs(viewPos.z - sampleDepth));
        occlusion += (sampleDepth >= samplePos.z + pc.bias ? 1.0 : 0.0) * rangeCheck;
    }
    occlusion = 1.0 - (occlusion / 64.0);
    occlusion = pow(occlusion, pc.power);
    imageStore(outAO, coord, vec4(occlusion, 0.0, 0.0, 0.0));
}
