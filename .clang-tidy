---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-deprecated-headers,
  modernize-loop-convert,
  modernize-make-shared,
  modernize-make-unique,
  readability-braces-around-statements,
  readability-else-after-return,
  readability-redundant-string-cstr,
  readability-simplify-boolean-expr,
  performance-for-range-copy,
  performance-unnecessary-copy-initialization,
  performance-faster-string-find,
  bugprone-suspicious-missing-comma,
  bugprone-narrowing-conversions,
  bugprone-integer-division,
  bugprone-macro-parentheses,
  misc-unused-parameters,
  misc-definitions-in-headers,
  -clang-analyzer-optin.performance.Padding,
  -clang-diagnostic-c++98-compat,
  -clang-diagnostic-c++98-compat-pedantic,
  -clang-diagnostic-deprecated,
  -clang-diagnostic-undef,
  -clang-diagnostic-unused-parameter

ChecksOptions:
  readability-else-after-return.WarnOnConditionVariables: true
  readability-braces-around-statements.ShortStatementLines: 2
  modernize-loop-convert.MinConfidence: reasonable
  bugprone-narrowing-conversions.PedanticMode: false

HeaderFilterRegex: 'src/.*\.(h|hpp)$'
AnalyzeTemporaryDtors: false
FormatStyle: file
WarningsAsErrors: '*'
...
