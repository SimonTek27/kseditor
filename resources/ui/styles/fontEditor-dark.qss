/* ===== GLOBAL BACKGROUND ===== */
QWidget {
    background-color: #1e1e2e;
    color: #e0e0e0;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ===== RIBBON BAR ===== */
QTabBar::tab {
    background-color: #2a2a3a;
    color: #a0a0b0;
    padding: 10px 20px;
    border: none;
    border-bottom: 3px solid transparent;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #32324a;
    color: #ffffff;
    border-bottom: 3px solid #4a9eff;
}

QTabBar::tab:hover {
    background-color: #3a3a5a;
    color: #ffffff;
}

QTabWidget::pane {
    border: none;
    background-color: #1e1e2e;
}

/* ===== RIBBON TOOLBAR ===== */
QToolBar#ribbonToolbar {
    background-color: #2a2a3a;
    border: none;
    padding: 8px 12px;
    spacing: 12px;
}

QComboBox {
    background-color: #1e1e2e;
    color: #e0e0e0;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    padding: 5px 10px;
    min-width: 110px;
}

QComboBox:hover {
    border-color: #4a9eff;
}

QSpinBox {
    background-color: #1e1e2e;
    color: #e0e0e0;
    border: 1px solid #3a3a4a;
    border-radius: 3px;
    padding: 2px 4px;
    min-width: 55px;
}

QSpinBox:hover {
    border-color: #4a9eff;
}

/* ===== CATEGORY GROUPS ===== */
QGroupBox#categoryGroup {
    background-color: #252538;
    border: 1px solid #3a3a4a;
    border-radius: 6px;
    margin: 6px;
    padding: 12px;
    font-weight: bold;
    color: #e0e0e0;
}

QGroupBox#categoryGroup.digit {
    border-color: #4aff8a;
}

QGroupBox#categoryGroup.symbol {
    border-color: #ff6a4a;
}

QGroupBox#categoryGroup.letter {
    border-color: #4a9eff;
}

QGroupBox#categoryGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #ffffff;
}

/* ===== CATEGORY CONTROLS (H Pad, V Pad, Width, Height) ===== */
QFrame#categoryControls {
    background-color: #2a2a3a;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 8px;
}

QLabel#controlLabel {
    color: #a0a0b0;
    font-size: 11px;
    padding: 2px 6px 2px 0;
}

/* ===== CHARACTER GRID ===== */
QFrame#charCell {
    background-color: #2a2a3a;
    border: 2px solid #3a3a4a;
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
}

QFrame#charCell:hover {
    background-color: #32324a;
}

QFrame#charCell.digit {
    border: 2px solid #4aff8a;
}

QFrame#charCell.symbol {
    border: 2px solid #ff6a4a;
}

QFrame#charCell.letter {
    border: 2px solid #4a9eff;
}

/* ===== GLYPH - FONT ALWAYS WHITE ===== */
QLabel#glyph {
    color: #ffffff;
    font-size: 24px;
    font-weight: bold;
    background-color: #1a1a2a;
    border-radius: 3px;
    padding: 4px;
    qproperty-alignment: AlignCenter;
    min-width: 32px;
    min-height: 32px;
}

/* ===== CHECKBOX ===== */
QCheckBox {
    color: #e0e0e0;
    spacing: 8px;
    padding: 4px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid #4a4a5a;
    background-color: #1e1e2e;
}

QCheckBox::indicator:checked {
    background-color: #4a9eff;
    border-color: #4a9eff;
}

/* ===== BUTTONS ===== */
QPushButton {
    background-color: #3a3a4a;
    color: #e0e0e0;
    border: 1px solid #4a4a5a;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 90px;
}

QPushButton:hover {
    background-color: #4a4a6a;
    border-color: #4a9eff;
}

QPushButton:pressed {
    background-color: #4a9eff;
}