#pragma once

#include <QObject>
#include <QUuid>
#include <QVector>
#include <QMap>

namespace ui {

struct GraphNode {
    QUuid id;
    QString name;
    QVector3D position;
    QVector3D rotation;
    QVector3D scale;
    QString type;
    QVariant data;

    GraphNode() : id(QUuid::createUuid()) {}
    GraphNode(const QUuid& id, const QString& name = QString(),
              const QVector3D& position = QVector3D(), const QVector3D& rotation = QVector3D(),
              const QVector3D& scale = QVector3D(), const QString& type = QString())
        : id(id), name(name), position(position), rotation(rotation), scale(scale), type(type) {}
};

struct GraphConnection {
    QUuid id;
    QUuid fromNodeId;
    QUuid toNodeId;
    QString portNameFrom;
    QString portNameTo;
    QString type;

    GraphConnection() : id(QUuid::createUuid()) {}
    GraphConnection(const QUuid& id, const QUuid& fromNodeId, const QUuid& toNodeId,
                    const QString& portNameFrom = QString(), const QString& portNameTo = QString(),
                    const QString& type = QString())
        : id(id), fromNodeId(fromNodeId), toNodeId(toNodeId), portNameFrom(portNameFrom),
          portNameTo(portNameTo), type(type) {}
};

} // namespace ui